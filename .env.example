# --- TikTok Configuration ---
# Optional: List of friend names to interact with (comma-separated)
FRIENDS_TO_STREAK=Friend1,Friend2

# Optional: List of messages to randomly choose from (comma-separated)
STREAK_MESSAGES=🔥,Let's go!,Good morning,เดี๋ยวไฟดับนะ!,Check-in

# --- Browser Configuration ---
# Set to false to see the browser running on your local machine
HEADLESS=true

# --- Notification Configuration ---
# Optional: LINE Notify Token (Get from https://notify-bot.line.me/)
LINE_TOKEN=your_line_token_here

# Optional: Telegram Bot Token (Get from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
